{
  "name": "@urban/task-manager",
  "version": "0.1.0",
  "description": "Typed core for the Task Manager local coordination kernel",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js"
    },
    "access": "public"
  },
  "scripts": {
    "check": "bun run format && bun run lint && bun run typecheck",
    "format": "oxfmt -c ../../oxfmt.config.ts .",
    "lint": "oxlint --fix --tsconfig ../../tsconfig.json -c ../../oxlint.config.ts .",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "effect": "catalog:"
  }
}
