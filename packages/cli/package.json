{
  "name": "@urban/task-manager-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agent task manager CLI",
  "bin": {
    "tm": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/main.ts",
    "./bin": null
  },
  "publishConfig": {
    "bin": {
      "tm": "./dist/bin.js"
    },
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/main.js",
      "./bin": null
    }
  },
  "scripts": {
    "check": "bun run format && bun run lint && bun run typecheck",
    "format": "oxfmt -c ../../oxfmt.config.ts .",
    "lint": "oxlint --fix --tsconfig ../../tsconfig.json -c ../../oxlint.config.ts .",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@urban/task-manager": "workspace:*",
    "effect": "catalog:"
  }
}
