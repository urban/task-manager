{
  "name": "@urban/task-manager-mono",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agent task manager monorepo",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-rc.108",
      "@effect/platform-bun": "4.0.0-rc.108",
      "@effect/platform-node": "4.0.0-rc.108",
      "@types/bun": "1.3.12",
      "@types/node": "24.12.2",
      "effect": "4.0.0-rc.108",
      "vite": "7.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run format && bun run lint && bun run typecheck && bun run test",
    "format": "oxfmt -c ./oxfmt.config.ts",
    "lint": "oxlint --fix --tsconfig tsconfig.json -c ./oxlint.config.ts .",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "@effect/vitest": "4.0.0-rc.108",
    "@types/bun": "^1.3.13",
    "oxfmt": "0.49.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.13"
}
