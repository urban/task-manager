{
  "name": "@urban/task-manager-mono",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agent task manager monorepo",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/sql-sqlite-bun": "4.0.0-rc.112",
      "@types/bun": "1.4.0",
      "@types/node": "24.12.2",
      "effect": "4.0.0-rc.112",
      "vite": "8.2.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run format && bun run lint && bun run typecheck && bun run test",
    "format": "oxfmt -c ./oxfmt.config.ts",
    "lint": "oxlint --fix --tsconfig tsconfig.json -c ./oxlint.config.ts .",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@effect/tsgo": "0.37.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "catalog:",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
